{
  "manifest_version": 3,
  "name": "X to XCancel & Instagram to Imginn Redirector",
  "version": "1.1.0",
  "description": "x.com linklerini xcancel.com'a, instagram.com linklerini imginn.com'a çevirir",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://x.com/*",
    "*://*.x.com/*",
    "*://instagram.com/*",
    "*://*.instagram.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  }
}
